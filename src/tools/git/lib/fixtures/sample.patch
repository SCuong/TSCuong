From 3ce8572ec08a7a2db181063678e651bbe4ff18ee Mon Sep 17 00:00:00 2001
From: Ada Lovelace <ada@example.com>
Date: Sun, 27 Sep 2026 14:12:00 +0700
Subject: [PATCH 1/2] refactor(cart): simplify subtotal and format prices with
 Intl

Use Array.reduce for the subtotal and Intl.NumberFormat so prices
respect the currency code.

Refs: #42
---
 src/cart.test.ts |  8 ++++++++
 src/cart.ts      | 10 +++-------
 2 files changed, 11 insertions(+), 7 deletions(-)
 create mode 100644 src/cart.test.ts

diff --git a/src/cart.test.ts b/src/cart.test.ts
new file mode 100644
index 0000000..f9d340b
--- /dev/null
+++ b/src/cart.test.ts
@@ -0,0 +1,8 @@
+import { describe, expect, it } from "vitest";
+import { subtotal } from "./cart";
+
+describe("subtotal", () => {
+  it("multiplies price by quantity", () => {
+    expect(subtotal([{ id: "a", price: 2, quantity: 3 }])).toBe(6);
+  });
+});
diff --git a/src/cart.ts b/src/cart.ts
index 341fe68..2e5ccdd 100644
--- a/src/cart.ts
+++ b/src/cart.ts
@@ -5,11 +5,7 @@ export interface Item {
 }
 
 export function subtotal(items: Item[]): number {
-  let total = 0;
-  for (const item of items) {
-    total += item.price * item.quantity;
-  }
-  return total;
+  return items.reduce((sum, item) => sum + item.price * item.quantity, 0);
 }
 
 export function itemCount(items: Item[]): number {
@@ -24,6 +20,6 @@ export function findItem(items: Item[], id: string): Item | undefined {
   return items.find((item) => item.id === id);
 }
 
-export function formatPrice(value: number): string {
-  return '$' + value.toFixed(2);
+export function formatPrice(value: number, currency = 'USD'): string {
+  return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(value);
 }
-- 
